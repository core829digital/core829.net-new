# CORE829 — variabili d'ambiente (copia in `.env.local` e compila i valori)
# Nessun secret reale deve mai essere committato. `.env*.local` è nel .gitignore.

# Dominio di produzione (per sitemap/metadata)
NEXT_PUBLIC_SITE_URL=https://core829.net

# Form di contatto (/contatti) — invio email via Resend (https://resend.com)
# 1. Crea un account su resend.com e genera una API key.
# 2. Verifica il dominio core829.net in Resend (DNS) per poter usare
#    un mittente @core829.net; finché non è verificato, lascia
#    CONTACT_FROM_EMAIL non impostata: verrà usato il mittente sandbox
#    di Resend (onboarding@resend.dev), che consegna solo alla mail
#    associata all'account Resend.
RESEND_API_KEY=
# Mittente delle email generate dal form (richiede dominio verificato)
CONTACT_FROM_EMAIL="CORE829 Website <noreply@core829.net>"
# Destinatario dei lead dal form (default: hello@core829.net)
CONTACT_TO_EMAIL=hello@core829.net
