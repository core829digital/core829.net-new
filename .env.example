# CORE829 — variabili d'ambiente (copia in `.env.local` e compila i valori)
# Nessun secret reale deve mai essere committato.

# Convex — deployment URL pubblico (es. https://your-deployment.convex.cloud)
# Se presente, il form di contatto usa la mutation Convex end-to-end.
NEXT_PUBLIC_CONVEX_URL=

# Convex — admin key (SOLO server-side, mai esposta al client)
# Usata dal fallback server-side del form via HTTP API.
CONVEX_ADMIN_KEY=

# Resend — API key per email transazionali (notifica interna + conferma)
RESEND_API_KEY=
# Email mittente verificata in Resend
RESEND_FROM=onboarding@resend.dev
# Email interna di notifica nuovi contatti
CONTACT_NOTIFY_EMAIL=

# Dominio di produzione (per sitemap/metadata)
NEXT_PUBLIC_SITE_URL=https://core829.net
